# Prod: public API URL (same host as Directwerk/.env DIRECTWERK_ISSUER, e.g. https://api.example.com)
# Docker/Coolify on the same network: use internal HTTP, e.g. http://directwerk:8080
DIRECTWERK_API_URL=http://localhost:8080
# Staging only: allow HTTPS upstream with self-signed certs (prefer internal HTTP instead)
# DIRECTWERK_UPSTREAM_TLS_INSECURE=true
# Used when the browser opens studio on localhost (not a tenant host).
NEXT_PUBLIC_DIRECTWERK_DEFAULT_TENANT_HOST=alpha-a.localhost
# Must match Directwerk/.env DIRECTWERK_TENANT_CLIENT_ID (default: directwerk-tenant-frontend)
OAUTH_CLIENT_ID=directwerk-tenant-frontend
# Must match Directwerk/.env DIRECTWERK_TENANT_CLIENT_SECRET
OAUTH_CLIENT_SECRET=dev-tenant-secret
