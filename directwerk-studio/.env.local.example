# Prod: public API URL (same host as Directwerk/.env DIRECTWERK_ISSUER, e.g. https://api.example.com)
# Docker/Coolify on the same network: use internal HTTP, e.g. http://directwerk:8080
DIRECTWERK_API_URL=http://localhost:8080
# Staging only: allow HTTPS upstream with self-signed certs (prefer internal HTTP instead)
# DIRECTWERK_UPSTREAM_TLS_INSECURE=true
# Must match Directwerk/.env DIRECTWERK_TENANT_CLIENT_ID (default: directwerk-tenant-frontend)
OAUTH_CLIENT_ID=directwerk-tenant-frontend
# Must match Directwerk/.env DIRECTWERK_TENANT_CLIENT_SECRET (leave empty, never commit a real secret)
OAUTH_CLIENT_SECRET=

# Optional platform Umami analytics (respects browser Do Not Track) — unset disables tracking
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_URL=
# NEXT_PUBLIC_UMAMI_SAMPLE_RATE=0.25
# NEXT_PUBLIC_UMAMI_MASK_LEVEL=moderate
# NEXT_PUBLIC_UMAMI_MAX_DURATION=300000

# Live Umami reader stats on /analytics via the studio BFF (server-only, never NEXT_PUBLIC).
# The key stays on the server; tenant/website resolve from the site-config.
# UMAMI_API_KEY=
# Optional API base override (needed for Umami Cloud, whose API lives on a separate host).
# UMAMI_API_BASE_URL=https://api.umami.is
