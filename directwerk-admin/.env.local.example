# Prod: public API URL (same host as Directwerk/.env DIRECTWERK_ISSUER, e.g. https://api.example.com)
DIRECTWERK_API_URL=http://localhost:8080
# Must match Directwerk/.env DIRECTWERK_PLATFORM_CLIENT_ID (default: directwerk-platform-admin)
OAUTH_CLIENT_ID=directwerk-platform-admin
# Must match Directwerk/.env DIRECTWERK_PLATFORM_CLIENT_SECRET
OAUTH_CLIENT_SECRET=
# Separate tenant OAuth client for dual-session products/grants UI (POC escape hatch)
# Must match Directwerk/.env DIRECTWERK_TENANT_CLIENT_ID (default: directwerk-tenant-frontend)
TENANT_OAUTH_CLIENT_ID=directwerk-tenant-frontend
# Must match Directwerk/.env DIRECTWERK_TENANT_CLIENT_SECRET
TENANT_OAUTH_CLIENT_SECRET=

# Optional platform Umami analytics (respects browser Do Not Track) — unset disables tracking
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_URL=
# NEXT_PUBLIC_UMAMI_SAMPLE_RATE=0.25
# NEXT_PUBLIC_UMAMI_MASK_LEVEL=moderate
# NEXT_PUBLIC_UMAMI_MAX_DURATION=300000
