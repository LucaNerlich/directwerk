{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "isolatedModules": true,
        "types": ["vitest/globals", "@testing-library/jest-dom"],
        "baseUrl": ".",
        "paths": {
            "#components": ["./src/components"],
            "#components/*": ["./src/components/*"],
            "#lib": ["./src/lib"],
            "#lib/*": ["./src/lib/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"]
}
