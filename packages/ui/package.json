{
    "name": "@directwerk/ui",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        "./theme.css": "./src/styles/theme.css",
        "./components/*": "./src/components/*.tsx",
        "./components/ui/*": "./src/components/ui/*.tsx",
        "./components/layout/*": "./src/components/layout/*.tsx",
        "./hooks/*": "./src/hooks/*.ts",
        "./lib/*": "./src/lib/*.ts"
    },
    "imports": {
        "#components/*": "./src/components/*.tsx",
        "#hooks/*": "./src/hooks/*.ts",
        "#lib/*": "./src/lib/*.ts"
    },
    "scripts": {
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@base-ui/react": "latest",
        "@directwerk/legal": "workspace:*",
        "class-variance-authority": "latest",
        "clsx": "latest",
        "lucide-react": "latest",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwind-merge": "latest",
        "tw-animate-css": "latest"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^22.20.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "jsdom": "^26.1.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "next": "^16.3.0"
    }
}
