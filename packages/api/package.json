{
    "name": "@directwerk/api",
    "version": "0.4.0",
    "private": true,
    "type": "module",
    "exports": {
        "./constants": "./src/constants.ts",
        "./types": "./src/types.ts",
        "./envelope": "./src/envelope.ts",
        "./site/createSiteConfigProvider": "./src/site/createSiteConfigProvider.tsx",
        "./server": "./src/server/index.ts",
        "./client": "./src/client/index.ts",
        "./format": "./src/format/money.ts",
        "./proxy": "./src/proxy/index.ts",
        "./tenant": "./src/tenant/index.ts",
        "./validation": "./src/validation/index.ts",
        "./generated/openapi": "./src/generated/openapi.ts",
        "./content/sanitizeContentHtml": "./src/content/sanitizeContentHtml.ts",
        "./auth/*": "./src/auth/*.ts",
        "./client/*": "./src/client/*.ts",
        "./datetime/*": "./src/datetime/*.ts",
        "./format/*": "./src/format/*.ts",
        "./media/*": "./src/media/*.ts",
        "./proxy/*": "./src/proxy/*.ts",
        "./server/*": "./src/server/*.ts",
        "./urls/*": "./src/urls/*.ts",
        "./validation/*": "./src/validation/*.ts"
    },
    "scripts": {
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "generate:openapi": "openapi-typescript ../../directwerk-docs/docs/openapi/directwerk-api.json -o src/generated/openapi.ts",
        "check:openapi": "pnpm generate:openapi && git diff --exit-code -- src/generated/openapi.ts"
    },
    "dependencies": {
        "sanitize-html": "2.17.5",
        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.2",
        "@types/node": "^22.20.1",
        "@types/react": "^19.2.18",
        "@types/sanitize-html": "^2.16.1",
        "jsdom": "^26.1.0",
        "openapi-typescript": "^7.10.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "next": "^16.3.0",
        "react": "^19.2.8"
    }
}
