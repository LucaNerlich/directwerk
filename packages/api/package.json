{
    "name": "@directwerk/api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        "./constants": "./src/constants.ts",
        "./types": "./src/types.ts",
        "./envelope": "./src/envelope.ts",
        "./site/createSiteConfigProvider": "./src/site/createSiteConfigProvider.tsx",
        "./server": "./src/server/index.ts",
        "./auth/*": "./src/auth/*.ts",
        "./client": "./src/client/index.ts",
        "./client/policies": "./src/client/policies.ts",
        "./datetime/publicationSchedule": "./src/datetime/publicationSchedule.ts",
        "./urls/feedUrls": "./src/urls/feedUrls.ts",
        "./urls/publicContentUrls": "./src/urls/publicContentUrls.ts",
        "./validation/adminModules": "./src/validation/adminModules.ts",
        "./format": "./src/format/money.ts",
        "./media/browserUpload": "./src/media/browserUpload.ts",
        "./proxy": "./src/proxy/index.ts",
        "./proxy/platformRouteHandler": "./src/proxy/platformRouteHandler.ts",
        "./tenant": "./src/tenant/index.ts",
        "./tenant/server": "./src/tenant/server.ts",
        "./validation": "./src/validation/index.ts",
        "./generated/openapi": "./src/generated/openapi.ts"
    },
    "scripts": {
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "generate:openapi": "openapi-typescript ../../directwerk-docs/docs/openapi/directwerk-api.json -o src/generated/openapi.ts",
        "check:openapi": "pnpm generate:openapi && git diff --exit-code -- src/generated/openapi.ts"
    },
    "dependencies": {
        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "@types/react": "^19.2.18",
        "jsdom": "^26.1.0",
        "openapi-typescript": "^7.10.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "next": "^16.3.0",
        "react": "^19.2.8"
    }
}