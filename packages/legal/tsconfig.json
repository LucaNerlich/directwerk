{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "isolatedModules": true,
        "noUncheckedIndexedAccess": false,
        "types": ["vitest/globals", "node"],
        "baseUrl": "."
    },
    "include": ["src/**/*.ts", "tests/**/*.ts"]
}
