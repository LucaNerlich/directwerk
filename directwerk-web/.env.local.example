# Prod: public API URL (same host as Directwerk/.env DIRECTWERK_ISSUER, e.g. https://api.example.com)
DIRECTWERK_API_URL=http://localhost:8080
# Must match Directwerk/.env DIRECTWERK_TENANT_CLIENT_ID (default: directwerk-tenant-frontend)
OAUTH_CLIENT_ID=directwerk-tenant-frontend
# Must match Directwerk/.env DIRECTWERK_TENANT_CLIENT_SECRET
OAUTH_CLIENT_SECRET=
# Optional: comma-separated HTTPS hostnames for next/image remote patterns
# MEDIA_IMAGE_REMOTE_HOSTS=directwerk-dev2.b-cdn.net
