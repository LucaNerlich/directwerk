# Copy to `.env.local` for local homepage development.

# Directwerk API (contact form + ALTCHA challenge)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public VitePress docs
NEXT_PUBLIC_DOCS_URL=http://localhost:5173

# Optional external Swagger link on /developers
# NEXT_PUBLIC_SWAGGER_URL=

# Optional platform Umami analytics (respects browser Do Not Track) — unset disables tracking
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_URL=
# NEXT_PUBLIC_UMAMI_SAMPLE_RATE=0.25
# NEXT_PUBLIC_UMAMI_MASK_LEVEL=moderate
# NEXT_PUBLIC_UMAMI_MAX_DURATION=300000
