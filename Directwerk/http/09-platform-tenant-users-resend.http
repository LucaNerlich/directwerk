
###

### @name resendTenantUserInvite
POST {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/users/{{editorUserId}}/resend-invite
Authorization: Bearer {{platformAccessToken}}
Accept: application/json

> {%
    client.test("Resend tenant user invite", function() {
        client.assert(response.status === 201 || response.status === 409,
            "Expected 201 or 409 for invited user");
    });
%}
