### Directwerk — Article RSS (ArticleRssFeedController + MeArticleFeedController)
### Prerequisites:
###   02-oauth2.http / 03-auth.http (platformAccessToken, subscriberAccessToken)
###   06-platform-tenants.http (tenantAId)
###   Active subscription for subscriber; ARTICLE_RSS + SUBSCRIPTION on tenant A.
###
### Ordering: ensure ARTICLE_RSS enabled, baseline public/private RSS, initialize
### articleFeedUrl (setup requires HTTP 200 + valid URL), then module-off gates.
### Serialization: run after http/22 via 00-index order. Do not run concurrently against
### the same tenant. Each off-check restores ARTICLE_RSS immediately afterward.

### @name ensureArticleRssEnabledBeforeGate
POST {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/modules/ARTICLE_RSS/activate
Authorization: Bearer {{platformAccessToken}}
Accept: application/json

> {%
    client.test("Ensure ARTICLE_RSS on before article RSS checks", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.enabledModules.includes("ARTICLE_RSS"), "Expected ARTICLE_RSS on");
    });
%}

###

### @name publicArticleRss
GET {{baseUrl}}/feeds/{{tenantASlug}}/articles.xml
Host: {{tenantAHost}}
Accept: application/rss+xml

> {%
    client.test("Public article RSS", function() {
        client.assert(response.status === 200 || response.status === 302 || response.status === 403 || response.status === 404, "Expected RSS redirect, XML, or gated 404/403");
        if (response.status === 403) {
            client.assert(response.body.errors[0].code === "FEATURE_NOT_ENABLED", "Expected FEATURE_NOT_ENABLED");
        }
    });
%}

###

### @name listMeArticleFeeds
GET {{baseUrl}}/api/v1/me/article-feeds
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Accept: application/json

> {%
    client.test("List subscriber article feeds", function() {
        client.assert(response.status === 200, "Expected 200 — ARTICLE_RSS must be enabled for setup");
        client.assert(Array.isArray(response.body.data) && response.body.data.length > 0, "Expected at least one feed");
        const feedUrl = response.body.data[0].url;
        client.assert(
            typeof feedUrl === "string" && feedUrl.includes("/feeds/") && feedUrl.endsWith(".xml"),
            "Expected a valid private article feed URL"
        );
        client.global.set("articleFeedUrl", feedUrl);
        client.global.set("defaultArticleFeedId", response.body.data[0].id);
    });
%}

###

### @name rotateDefaultArticleFeedToken
POST {{baseUrl}}/api/v1/me/article-feeds/default/rotate-token
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Accept: application/json

> {%
    client.test("Rotate default article feed token", function() {
        client.assert(response.status === 200, "Expected 200 — ARTICLE_RSS must be enabled for setup");
        const feedUrl = response.body.data && response.body.data.url;
        client.assert(
            typeof feedUrl === "string" && feedUrl.includes("/feeds/") && feedUrl.endsWith(".xml"),
            "Expected a valid private article feed URL"
        );
        client.global.set("articleFeedUrl", feedUrl);
    });
%}

###

### @name privateArticleFeed
GET {{articleFeedUrl}}
Host: {{tenantAHost}}
Accept: application/rss+xml

> {%
    client.test("Private article RSS", function() {
        client.assert(response.status === 200 || response.status === 302 || response.status === 403 || response.status === 404, "Expected RSS redirect, XML, or soft failure");
        if (response.status === 200) {
            client.assert(response.body.includes("<rss"), "Expected RSS XML");
        }
        if (response.status === 403) {
            client.assert(response.body.errors[0].code === "FEATURE_NOT_ENABLED", "Expected FEATURE_NOT_ENABLED");
        }
    });
%}

###

### @name deactivateArticleRssForPublicOff
DELETE {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/modules/ARTICLE_RSS
Authorization: Bearer {{platformAccessToken}}
Accept: application/json

> {%
    client.test("Deactivate ARTICLE_RSS for public article feed", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(!response.body.data.enabledModules.includes("ARTICLE_RSS"), "Expected ARTICLE_RSS off");
    });
%}

###

### @name publicArticleRssModuleOff
GET {{baseUrl}}/feeds/{{tenantASlug}}/articles.xml
Host: {{tenantAHost}}
Accept: application/rss+xml

> {%
    client.test("Public article RSS without ARTICLE_RSS", function() {
        client.assert(response.status === 403, "Expected 403");
        client.assert(response.body.errors[0].code === "FEATURE_NOT_ENABLED", "Expected FEATURE_NOT_ENABLED");
    });
%}

###

### @name restoreArticleRssAfterPublicOff
POST {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/modules/ARTICLE_RSS/activate
Authorization: Bearer {{platformAccessToken}}
Accept: application/json

> {%
    client.test("Restore ARTICLE_RSS after public article gate", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.enabledModules.includes("ARTICLE_RSS"), "Expected ARTICLE_RSS on");
    });
%}

###

### @name deactivateArticleRssForPrivateOff
DELETE {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/modules/ARTICLE_RSS
Authorization: Bearer {{platformAccessToken}}
Accept: application/json

> {%
    client.test("Deactivate ARTICLE_RSS for private article feed", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(!response.body.data.enabledModules.includes("ARTICLE_RSS"), "Expected ARTICLE_RSS off");
    });
%}

###

### @name privateArticleFeedModuleOff
GET {{articleFeedUrl}}
Host: {{tenantAHost}}
Accept: application/rss+xml

> {%
    client.test("Private article RSS without ARTICLE_RSS", function() {
        const feedUrl = client.global.get("articleFeedUrl");
        client.assert(
            typeof feedUrl === "string" && feedUrl.includes("/feeds/") && feedUrl.endsWith(".xml"),
            "articleFeedUrl must be initialized before gate checks"
        );
        client.assert(response.status === 403, "Expected 403");
        client.assert(response.body.errors[0].code === "FEATURE_NOT_ENABLED", "Expected FEATURE_NOT_ENABLED");
    });
%}

###

### @name restoreArticleRssAfterPrivateOff
POST {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/modules/ARTICLE_RSS/activate
Authorization: Bearer {{platformAccessToken}}
Accept: application/json

> {%
    client.test("Restore ARTICLE_RSS after private article gate", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.enabledModules.includes("ARTICLE_RSS"), "Expected ARTICLE_RSS on");
    });
%}
