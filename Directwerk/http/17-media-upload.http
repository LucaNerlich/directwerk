### @name renameMediaFolder
PUT {{baseUrl}}/api/v1/media/folders/{{mediaFolderId}}
Authorization: Bearer {{tenantAAccessToken}}
Host: {{tenantAHost}}
Content-Type: application/json
Accept: application/json

{
  "name": "Interviews (Archiv)"
}

> {%
    client.test("Rename media folder", function() {
        client.assert(response.status === 200 || response.status === 404 || response.status === 409 || response.status === 503, "Expected 200/404/409/503");
    });
%}

###

### @name moveMediaFolder
### Null parentId moves to the library root. Cycles and depth > 8 are rejected with 400.
POST {{baseUrl}}/api/v1/media/folders/{{mediaFolderId}}/move
Authorization: Bearer {{tenantAAccessToken}}
Host: {{tenantAHost}}
Content-Type: application/json
Accept: application/json

{
  "parentId": null
}

> {%
    client.test("Move media folder", function() {
        client.assert(response.status === 200 || response.status === 400 || response.status === 404 || response.status === 503, "Expected 200/400/404/503");
    });
%}

###

### @name moveMediaAsset
### Null folderId moves the asset back to the library root. S3 keys are untouched.
POST {{baseUrl}}/api/v1/media/{{mediaAssetId}}/move
Authorization: Bearer {{tenantAAccessToken}}
Host: {{tenantAHost}}
Content-Type: application/json
Accept: application/json

{
  "folderId": {{mediaFolderId}}
}

> {%
    client.test("Move media asset", function() {
        client.assert(response.status === 200 || response.status === 404 || response.status === 503, "Expected 200/404/503");
    });
%}

###

### @name deleteMediaFolder
### mode=move_to_parent (default) moves assets/subfolders up; mode=delete_contents deletes them.
DELETE {{baseUrl}}/api/v1/media/folders/{{mediaFolderId}}?mode=move_to_parent
Authorization: Bearer {{tenantAAccessToken}}
Host: {{tenantAHost}}
Accept: application/json

> {%
    client.test("Delete media folder", function() {
        client.assert(response.status === 200 || response.status === 404 || response.status === 503, "Expected 200/404/503");
    });
%}
