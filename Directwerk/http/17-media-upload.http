### Exact-folder filter; add &recursive=true for descendants, or ?unassignedOnly=true for root assets.
GET {{baseUrl}}/api/v1/media?folderId={{mediaFolderId}}&limit=20
Authorization: Bearer {{tenantAAccessToken}}
Host: {{tenantAHost}}
Accept: application/json

> {%
    client.test("List media in folder", function() {
        client.assert(response.status === 200 || response.status === 404 || response.status === 503, "Expected 200/404/503");
    });
%}

