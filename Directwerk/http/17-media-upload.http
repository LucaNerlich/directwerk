###

### @name createMediaFolder
### Folder names are unique per parent (case-sensitive); omit parentId for root. Max depth 8.
POST {{baseUrl}}/api/v1/media/folders
Authorization: Bearer {{tenantAAccessToken}}
Host: {{tenantAHost}}
Content-Type: application/json
Accept: application/json

{
  "name": "Interviews",
  "parentId": null
}

> {%
    client.test("Create media folder", function() {
        client.assert(response.status === 201 || response.status === 409 || response.status === 503, "Expected 201/409/503");
        if (response.status === 201) {
            client.assert(response.body.data.id, "Expected folder id");
            client.global.set("mediaFolderId", response.body.data.id);
        }
    });
%}

