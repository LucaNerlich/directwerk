### @name getContentEmailTemplateArticle
GET {{baseUrl}}/api/v1/tenant/content-email-templates/ARTICLE
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Accept: application/json

> {%
    client.test("Get article content email template", function() {
        client.assert(response.status === 200 || response.status === 403, "Expected 200 or 403");
    });
%}

###

### @name putContentEmailTemplateArticle
PUT {{baseUrl}}/api/v1/tenant/content-email-templates/ARTICLE
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "subjectTemplate": "New post: {{title}}",
  "bodyHtml": "<p>Hi {{recipientName}},</p><p>{{siteTitle}} published <strong>{{title}}</strong>.</p><p>{{excerpt}}</p><p><a href=\"{{contentUrl}}\">Read now</a></p>"
}

> {%
    client.test("Put article content email template", function() {
        client.assert(response.status === 200 || response.status === 403, "Expected 200 or 403");
    });
%}
