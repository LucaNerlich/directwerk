### Directwerk — TenantSubscriptionController + TenantSubscriberController
### Prerequisites: 02-oauth2 / 03-auth (tenantAAccessToken, subscriberAccessToken, supporterProductId)

### @name listSubscribers
GET {{baseUrl}}/api/v1/tenant/subscribers?page=0&size=50
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Accept: application/json

> {%
    client.test("GET /tenant/subscribers", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body.data), "Expected subscribers array");
        client.assert(typeof response.body.metadata.page === "number", "Expected page metadata");
        client.assert(typeof response.body.metadata.size === "number", "Expected size metadata");
        client.assert(typeof response.body.metadata.totalElements === "number", "Expected totalElements");
        if (response.body.data.length > 0) {
            client.global.set("subscriberUserId", response.body.data[0].userId);
            if (response.body.data[0].subscriptions.length > 0) {
                client.assert(
                    Object.prototype.hasOwnProperty.call(
                        response.body.data[0].subscriptions[0],
                        "externalSubscriptionId"
                    ),
                    "Expected externalSubscriptionId on subscription items"
                );
            }
        }
    });
%}

###

### @name getSubscriberAccess
GET {{baseUrl}}/api/v1/tenant/subscribers/{{subscriberUserId}}/access
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Accept: application/json

> {%
    client.test("GET /tenant/subscribers/{id}/access", function() {
        client.assert(response.status === 200 || response.status === 404, "Expected 200 or 404");
        if (response.status === 200) {
            client.assert(Array.isArray(response.body.data.activeLevels), "Expected activeLevels");
            client.assert(Array.isArray(response.body.data.activePackages), "Expected activePackages");
            client.assert(
                Object.prototype.hasOwnProperty.call(response.body.data, "maxLevelSortOrder"),
                "Expected maxLevelSortOrder"
            );
        }
    });
%}

###

### @name getSubscriberAccessEpisodeCheck
GET {{baseUrl}}/api/v1/tenant/subscribers/{{subscriberUserId}}/access?episodeId={{episodeId}}
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Accept: application/json

> {%
    client.test("GET subscriber access with episodeId", function() {
        client.assert(
            response.status === 200 || response.status === 404,
            "Expected 200 or 404"
        );
        if (response.status === 200 && response.body.data.check) {
            client.assert(response.body.data.check.kind === "EPISODE", "Expected EPISODE check");
            client.assert(typeof response.body.data.check.allowed === "boolean", "Expected allowed");
            client.assert(typeof response.body.data.check.reason === "string", "Expected reason");
        }
    });
%}

###

### @name grantSubscription
POST {{baseUrl}}/api/v1/tenant/subscriptions
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "email": "{{subscriberEmail}}",
  "productId": {{supporterProductId}}
}

> {%
    client.test("Grant subscription", function() {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.body.data.status === "ACTIVE", "Expected ACTIVE");
        client.global.set("subscriberSubscriptionId", response.body.data.id);
    });
%}

###

### @name revokeSubscription
### Stripe-sourced rows also cancel in Stripe when keys + Connect exist (502 STRIPE_REQUEST_FAILED otherwise).
DELETE {{baseUrl}}/api/v1/tenant/subscriptions/{{subscriberSubscriptionId}}
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Accept: application/json

> {%
    client.test("Revoke subscription", function() {
        client.assert(response.status === 200 || response.status === 502, "Expected 200/502");
        if (response.status === 200) {
            client.assert(response.body.data.status === "CANCELED", "Expected CANCELED");
        }
    });
%}
