### Directwerk — Newsletter desk articles (Phase 3b)
### Prerequisites: 02-oauth2.http (tenantAAccessToken), DIGITAL_CONTENT active for tenant A.

### @name createArticleDraft
< {%
  client.global.set("articleSlug", "article-" + Date.now().toString(36));
%}
POST {{baseUrl}}/api/v1/articles
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "slug": "{{articleSlug}}",
  "title": "Harness Article",
  "body": "<p>Newsletter desk content from the HTTP harness.</p>",
  "excerpt": "Created by 24-articles.http",
  "accessPolicy": "FREE",
  "categoryIds": []
}

> {%
    client.test("Create article draft", function() {
        client.assert(response.status === 201 || response.status === 403, "Expected 201 or 403 when DIGITAL_CONTENT is off");
        if (response.status === 201) {
            client.global.set("articleId", response.body.data.id);
            client.global.set("articleSlug", response.body.data.slug);
        }
        // On 403, articleId/articleSlug remain unset; dependent requests will fail
    });
%}

