### @name unarchiveArticle
POST {{baseUrl}}/api/v1/articles/{{articleNotifyId}}/unarchive
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Accept: application/json

> {%
    client.test("Unarchive article", function() {
        client.assert(response.status === 200, "Expected 200 for restoring archived article to draft");
        client.assert(response.body.data.status === "DRAFT", "Expected DRAFT after unarchive");
    });
%}
