### @name createArticleDraftForNotify
< {%
  client.global.set("articleNotifySlug", "article-notify-" + Date.now().toString(36));
%}
POST {{baseUrl}}/api/v1/articles
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "slug": "{{articleNotifySlug}}",
  "title": "Harness Article with Notification",
  "body": "<p>Article to test notify-on-publish flow.</p>",
  "excerpt": "Created for notification test",
  "accessPolicy": "FREE",
  "categoryIds": []
}

> {%
    client.test("Create article draft for notify test", function() {
        client.assert(response.status === 201 || response.status === 403, "Expected 201 or 403 when DIGITAL_CONTENT is off");
        if (response.status === 201) {
            client.global.set("articleNotifyId", response.body.data.id);
        }
    });
%}

###

### @name publishArticleNotifySubscribers
POST {{baseUrl}}/api/v1/articles/{{articleNotifyId}}/publish
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "notifySubscribers": true
}

> {%
    client.test("Publish article with subscriber notification", function() {
        client.assert(response.status === 200, "Expected 200 after notification draft setup");
    });
%}

