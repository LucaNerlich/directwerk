### @name deleteDefaultArticleFeedForbidden
DELETE {{baseUrl}}/api/v1/me/article-feeds/{{defaultArticleFeedId}}
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Accept: application/json

> {%
    client.test("Default article feed is not deletable", function() {
        client.assert(response.status === 409, "Expected 409");
