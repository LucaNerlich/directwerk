### @name rotateCustomArticleFeedToken
POST {{baseUrl}}/api/v1/me/article-feeds/{{customArticleFeedId}}/rotate-token
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Accept: application/json

> {%
    client.test("Rotate custom article feed token", function() {
        client.assert(response.status === 200, "Expected 200");
        const feedUrl = response.body.data && response.body.data.url;
        client.assert(typeof feedUrl === "string" && feedUrl.endsWith(".xml"), "Expected new URL");
        client.global.set("customArticleFeedUrl", feedUrl);
    });
%}

