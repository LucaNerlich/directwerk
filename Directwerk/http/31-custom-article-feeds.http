### @name createCustomArticleFeedMissingCategories
POST {{baseUrl}}/api/v1/me/article-feeds
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Missing categories",
  "categoryIds": []
}

> {%
    client.test("Missing categories", function() {
        client.assert(response.status === 400, "Expected 400");
        client.assert(response.body.errors[0].code === "FEED_CATEGORIES_REQUIRED", "Expected FEED_CATEGORIES_REQUIRED");
    });
%}

