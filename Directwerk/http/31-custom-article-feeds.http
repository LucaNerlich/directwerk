###

### @name deactivateArticleFeedBuilderForCustomFeedOff
DELETE {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/modules/ARTICLE_FEED_BUILDER
Authorization: Bearer {{platformAccessToken}}
Accept: application/json

> {%
    client.test("Deactivate ARTICLE_FEED_BUILDER", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(!response.body.data.enabledModules.includes("ARTICLE_FEED_BUILDER"), "Expected ARTICLE_FEED_BUILDER off");
    });
%}

###

### @name privateCustomArticleFeedModuleOff
GET {{customArticleFeedUrl}}
Host: {{tenantAHost}}
Accept: application/rss+xml

> {%
    client.test("Custom article RSS without ARTICLE_FEED_BUILDER is 404 not JSON 403", function() {
        const feedUrl = client.global.get("customArticleFeedUrl");
        client.assert(typeof feedUrl === "string" && feedUrl.endsWith(".xml"), "customArticleFeedUrl must be initialized");
        client.assert(response.status === 404, "Expected 404");
        client.assert(
            !response.body || !response.body.errors || response.body.errors[0].code !== "FEATURE_NOT_ENABLED",
            "Must not return FEATURE_NOT_ENABLED JSON"
        );
    });
%}

###

### @name createCustomArticleFeedModuleOff
POST {{baseUrl}}/api/v1/me/article-feeds
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Should fail",
  "categoryIds": [{{articleCategoryId}}]
}

> {%
    client.test("Create custom article feed without ARTICLE_FEED_BUILDER", function() {
        client.assert(response.status === 403, "Expected 403");
        client.assert(response.body.errors[0].code === "FEATURE_NOT_ENABLED", "Expected FEATURE_NOT_ENABLED");
    });
%}

