### Directwerk — PublicSiteConfigController + PublicSubscriptionProductController
### No auth — tenant from Host

### @name siteConfigTenantA
GET {{baseUrl}}/api/v1/public/site-config
Host: {{tenantAHost}}
Accept: application/json

> {%
    client.test("Site config tenant A", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.tenant.slug === client.global.get("tenantASlug"), "Expected tenant A slug");
        client.assert(Array.isArray(response.body.data.enabledModules), "Expected enabledModules");
    });
%}

###

### @name siteConfigTenantB
GET {{baseUrl}}/api/v1/public/site-config
Host: {{tenantBHost}}
Accept: application/json

> {%
    client.test("Site config tenant B", function() {
        client.assert(response.status === 200, "Expected 200");
