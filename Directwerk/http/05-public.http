###

### @name publicProductsTenantA
GET {{baseUrl}}/api/v1/public/products
Host: {{tenantAHost}}
Accept: application/json

> {%
    client.test("Public products tenant A", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body.data), "Expected products array");
        if (response.body.data.length > 0) {
            client.assert(typeof response.body.data[0].currency === "string", "Expected currency");
            client.assert(typeof response.body.data[0].billingInterval === "string", "Expected billingInterval");
        }
    });
%}

###

### @name publicLevelsTenantA
GET {{baseUrl}}/api/v1/public/levels
Host: {{tenantAHost}}
Accept: application/json

> {%
    client.test("Public levels tenant A", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body.data), "Expected levels array");
        if (response.body.data.length > 0) {
            client.assert(typeof response.body.data[0].id === "number", "Expected id");
            client.assert(typeof response.body.data[0].slug === "string", "Expected slug");
            client.assert(typeof response.body.data[0].title === "string", "Expected title");
            client.assert(typeof response.body.data[0].sortOrder === "number", "Expected sortOrder");
        }
    });
%}

