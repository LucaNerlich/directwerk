}

> {%
    client.test("Attach podcast episode audio", function() {
        client.assert(
            response.status === 200 || response.status === 400 || response.status === 404,
            "Expected 200/400/404 — needs READY audio asset from 17-media-upload.http"
        );
    });
%}

