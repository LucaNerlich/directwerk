### Directwerk — Podcast content (Phase 3)
### Prerequisites: 02-oauth2.http (tenantAAccessToken), PODCAST active for tenant A.
### Publish may return EPISODE_VALIDATION_FAILED until a READY audio asset is attached.

### @name createPodcastFormat
< {%
  client.global.set("podcastFormatSlug", "format-" + Date.now().toString(36));
%}
POST {{baseUrl}}/api/v1/formats
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "slug": "{{podcastFormatSlug}}",
  "name": "Harness Format",
  "description": "Created by the HTTP harness",
  "sortOrder": 10
}

> {%
    client.test("Create podcast format", function() {
        client.assert(response.status === 201 || response.status === 403, "Expected 201 or 403 when PODCAST is off");
        if (response.status === 201) {
            client.global.set("podcastFormatId", response.body.data.id);
        }
    });
%}

###

### @name createPodcastSeries
< {%
  client.global.set("podcastSeriesSlug", "series-" + Date.now().toString(36));
%}
POST {{baseUrl}}/api/v1/series
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "slug": "{{podcastSeriesSlug}}",
  "title": "Harness Podcast",
  "description": "<p>Podcast created by the HTTP harness.</p>",
  "language": "de",
  "itunesCategory": "News"
}

> {%
    client.test("Create podcast series", function() {
        client.assert(response.status === 201 || response.status === 403, "Expected 201 or 403 when PODCAST is off");
        if (response.status === 201) {
            client.global.set("podcastSeriesId", response.body.data.id);
        }
    });
%}

