### Directwerk — Podcast content (Phase 3)
### Prerequisites: 02-oauth2.http (tenantAAccessToken), 07-platform-modules.http (PODCAST active),
###                17-media-upload.http (mediaAssetId optional for attach audio; use a READY PUBLIC IMAGE id for coverAssetId on series/format/episode).
### Publish may return EPISODE_VALIDATION_FAILED until a READY audio asset is attached.

### @name listPodcastFormats
GET {{baseUrl}}/api/v1/formats
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Accept: application/json

> {%
    client.test("List podcast formats", function() {
        client.assert(response.status === 200 || response.status === 403, "Expected 200 or 403");
        if (response.status === 200) {
            client.assert(Array.isArray(response.body.data), "Expected formats array");
        }
    });
%}

###

### @name createPodcastFormat
< {%
  client.global.set("podcastFormatSlug", "format-" + Date.now().toString(36));
%}
POST {{baseUrl}}/api/v1/formats
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "slug": "{{podcastFormatSlug}}",
  "name": "Harness Format",
  "description": "Created by the HTTP harness",
  "sortOrder": 10
}

> {%
    client.test("Create podcast format", function() {
        client.assert(response.status === 201 || response.status === 403 || response.status === 500,
            "Expected 201, 403, or known 500 on re-run");
        if (response.status === 201) {
            client.global.set("podcastFormatId", response.body.data.id);
        }
    });
%}

###

### @name updatePodcastFormat
PUT {{baseUrl}}/api/v1/formats/{{podcastFormatId}}
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "slug": "{{podcastFormatSlug}}",
  "name": "Harness Format Updated",
  "sortOrder": 10,
  "active": true
}

> {%
    client.test("Update podcast format", function() {
        client.assert(response.status === 200 || response.status === 404, "Expected 200 or 404");
    });
%}

