### @name createPodcastEpisodeDraft
< {%
  client.global.set("podcastEpisodeSlug", "episode-" + Date.now().toString(36));
%}
POST {{baseUrl}}/api/v1/episodes
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "seriesId": {{podcastSeriesId}},
  "episodeNumber": 1,
  "slug": "{{podcastEpisodeSlug}}",
  "title": "Harness Episode",
  "description": "<p>Show notes with <strong>allowed HTML</strong>.</p>",
  "accessPolicy": "FREE",
  "formatIds": [{{podcastFormatId}}]
}

> {%
    client.test("Create podcast episode draft", function() {
        client.assert(response.status === 201 || response.status === 400 || response.status === 403, "Expected draft response");
        if (response.status === 201) {
            client.global.set("podcastEpisodeId", response.body.data.id);
        }
    });
%}

###

### @name publishPodcastEpisode
POST {{baseUrl}}/api/v1/episodes/{{podcastEpisodeId}}/publish
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "notifySubscribers": false
}

> {%
    client.test("Publish podcast episode", function() {
        client.assert(
            response.status === 200 || response.status === 400 || response.status === 403 || response.status === 404,
            "Expected publish success or soft failure without READY audio/PODCAST"
        );
    });
%}

###

### @name createPodcastEpisodeDraftForNotify
< {%
  client.global.set("podcastEpisodeNotifySlug", "episode-notify-" + Date.now().toString(36));
%}
POST {{baseUrl}}/api/v1/episodes
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "seriesId": {{podcastSeriesId}},
  "episodeNumber": 2,
  "slug": "{{podcastEpisodeNotifySlug}}",
  "title": "Harness Episode with Notification",
  "description": "<p>Episode to test notify-on-publish flow.</p>",
  "accessPolicy": "FREE",
  "formatIds": [{{podcastFormatId}}]
}

> {%
    client.test("Create episode draft for notify test", function() {
        client.assert(response.status === 201 || response.status === 400 || response.status === 403, "Expected draft response");
        if (response.status === 201) {
            client.global.set("podcastEpisodeNotifyId", response.body.data.id);
        }
    });
%}

###

### @name publishPodcastEpisodeNotifySubscribers
POST {{baseUrl}}/api/v1/episodes/{{podcastEpisodeNotifyId}}/publish
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "notifySubscribers": true
}

> {%
    client.test("Publish episode with subscriber notification", function() {
        client.assert(
            response.status === 200 || response.status === 400 || response.status === 403 || response.status === 404,
            "Expected publish response"
        );
    });
%}

