### @name listPublicPodcastEpisodes
GET {{baseUrl}}/api/v1/public/episodes
Host: {{tenantAHost}}
Accept: application/json

> {%
    client.test("List public podcast episodes", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body.data), "Expected public episodes array");
    });
%}
