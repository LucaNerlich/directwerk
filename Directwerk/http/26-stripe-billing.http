### @name createPortalSession
POST {{baseUrl}}/api/v1/me/billing/portal
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Content-Type: application/json
Accept: application/json

{}

> {%
    client.test("POST /me/billing/portal", function() {
        client.assert(response.status === 201 || response.status === 409 || response.status === 501, "Expected 201/409/501");
    });
%}

###

### charge.refunded (signed, live): full refund of a one-time PaymentIntent cancels
### the matching STRIPE row without externalSubscriptionId. Recurring invoice
### refunds must not auto-cancel. Unsigned payloads below only probe signature.

### @name stripeWebhookMissingSignature
POST {{baseUrl}}/api/v1/webhooks/stripe
Content-Type: application/json
Accept: application/json

{
  "id": "evt_test",
  "type": "checkout.session.completed"
}

> {%
    client.test("POST /webhooks/stripe unsigned", function() {
        client.assert(response.status === 400 || response.status === 501, "Expected 400/501");
    });
%}

###

### @name stripeWebhookInvalidSignature
POST {{baseUrl}}/api/v1/webhooks/stripe
Content-Type: application/json
Accept: application/json
Stripe-Signature: t=1,v1=deadbeef

{
  "id": "evt_test_invalid_sig",
  "type": "checkout.session.completed"
}

> {%
    client.test("POST /webhooks/stripe invalid signature", function() {
        client.assert(response.status === 400 || response.status === 501, "Expected 400/501");
        if (response.status === 400) {
            client.assert(response.body.errors[0].code === "STRIPE_SIGNATURE_INVALID", "Expected STRIPE_SIGNATURE_INVALID");
        }
    });
%}
