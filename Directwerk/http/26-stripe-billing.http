### Directwerk — Stripe Connect, dashboard, checkout, portal, webhook
### Prerequisites: 02-oauth2.http (tenantAAccessToken, subscriberAccessToken)

### @name stripeStatus
GET {{baseUrl}}/api/v1/tenant/stripe/status
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Accept: application/json

> {%
    client.test("GET /tenant/stripe/status", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(typeof response.body.data.status === "string", "Expected status");
        client.assert(typeof response.body.data.chargesEnabled === "boolean", "Expected chargesEnabled");
    });
%}

###

### @name billingDashboard
GET {{baseUrl}}/api/v1/tenant/billing/dashboard
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Accept: application/json

> {%
    client.test("GET /tenant/billing/dashboard", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body.data.memberships), "Expected memberships");
        client.assert(typeof response.body.data.stats.activeSubscriptions === "number", "Expected stats");
        client.assert(typeof response.body.data.stats.pastDueSubscriptions === "number", "Expected pastDue");
        client.assert(typeof response.body.data.stats.incompleteSubscriptions === "number", "Expected incomplete");
        client.assert(typeof response.body.data.stats.totalMemberships === "number", "Expected totalMemberships");
    });
%}

###

### @name stripeOnboard
POST {{baseUrl}}/api/v1/tenant/stripe/onboard
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "returnUrl": "http://localhost:3000/settings/stripe?onboard=return",
  "refreshUrl": "http://localhost:3000/settings/stripe?onboard=refresh"
}

> {%
    client.test("POST /tenant/stripe/onboard", function() {
        client.assert(response.status === 200 || response.status === 501 || response.status === 403, "Expected 200/501/403");
        if (response.status === 501) {
            client.assert(response.body.errors[0].code === "STRIPE_NOT_IMPLEMENTED", "Expected STRIPE_NOT_IMPLEMENTED");
        }
    });
%}

