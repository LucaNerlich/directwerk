### @name reactivateTenantC
POST {{baseUrl}}/api/v1/platform/tenants/{{tenantCId}}/reactivate
Authorization: Bearer {{platformAccessToken}}
Accept: application/json

> {%
    client.test("Reactivate tenant", function() {
        client.assert(response.status === 200 || response.status === 404,
            "Expected 200 when tenantCId set");
        if (response.status === 200) {
            client.assert(response.body.data.status === "ACTIVE", "Expected ACTIVE");
        }
