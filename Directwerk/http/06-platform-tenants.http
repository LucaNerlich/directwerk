### @name suspendTenantC
POST {{baseUrl}}/api/v1/platform/tenants/{{tenantCId}}/suspend
Authorization: Bearer {{platformAccessToken}}
Accept: application/json

> {%
    client.test("Suspend tenant", function() {
        client.assert(response.status === 200 || response.status === 404,
            "Expected 200 when tenantCId set");
        if (response.status === 200) {
            client.assert(response.body.data.status === "SUSPENDED", "Expected SUSPENDED");
        }
    });
%}

