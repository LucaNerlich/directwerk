### Directwerk — Tenant admin article feed management (TenantArticleFeedController)
### Prerequisites:
###   02-oauth2.http / 03-auth.http (tenantAAccessToken)
###   Subscriber with default article feed created (see 30-article-rss.http listMeArticleFeeds)
###   ARTICLE_RSS + SUBSCRIPTION enabled on tenant A.
###
### Covers: list tenant article feeds, enable/disable an article feed.

### @name listTenantArticleFeeds
GET {{baseUrl}}/api/v1/tenant/article-feeds
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Accept: application/json

> {%
    client.test("List tenant article feeds", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body.data), "Expected an array of feeds");
        client.assert(
            typeof response.body.data[0].userEmail === "string",
            "Expected userEmail on each feed"
        );
        client.assert(Array.isArray(response.body.data[0].categoryIds), "Expected categoryIds");
        client.global.set("articleFeedId", response.body.data[0].id);
    });
%}

###

### @name disableArticleFeed
PUT {{baseUrl}}/api/v1/tenant/article-feeds/{{articleFeedId}}/enabled
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Accept: application/json
Content-Type: application/json

{
    "enabled": false
}

> {%
    client.test("Disable article feed", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.enabled === false, "Expected feed disabled");
    });
%}

###

### @name enableArticleFeed
PUT {{baseUrl}}/api/v1/tenant/article-feeds/{{articleFeedId}}/enabled
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Accept: application/json
Content-Type: application/json

{
    "enabled": true
}

> {%
    client.test("Enable article feed", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.enabled === true, "Expected feed enabled");
    });
%}
