### @name deactivateFeedBuilderForCustomFeedOff
DELETE {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/modules/FEED_BUILDER
Authorization: Bearer {{platformAccessToken}}
Accept: application/json

> {%
    client.test("Deactivate FEED_BUILDER", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(!response.body.data.enabledModules.includes("FEED_BUILDER"), "Expected FEED_BUILDER off");
    });
%}

###

### @name privateCustomFeedModuleOff
GET {{customFeedUrl}}
Host: {{tenantAHost}}
Accept: application/rss+xml

> {%
    client.test("Custom RSS without FEED_BUILDER is 404 not JSON 403", function() {
        const feedUrl = client.global.get("customFeedUrl");
        client.assert(typeof feedUrl === "string" && feedUrl.endsWith(".xml"), "customFeedUrl must be initialized");
        client.assert(response.status === 404, "Expected 404");
        client.assert(
            !response.body || !response.body.errors || response.body.errors[0].code !== "FEATURE_NOT_ENABLED",
            "Must not return FEATURE_NOT_ENABLED JSON"
        );
    });
%}

###

### @name createCustomFeedModuleOff
POST {{baseUrl}}/api/v1/me/feeds
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Should fail",
  "formatIds": [{{podcastFormatId}}]
}

> {%
    client.test("Create custom feed without FEED_BUILDER", function() {
        client.assert(response.status === 403, "Expected 403");
        client.assert(response.body.errors[0].code === "FEATURE_NOT_ENABLED", "Expected FEATURE_NOT_ENABLED");
    });
%}

