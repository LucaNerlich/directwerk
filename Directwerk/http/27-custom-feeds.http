### @name privateCustomFeed
GET {{customFeedUrl}}
Host: {{tenantAHost}}
Accept: application/rss+xml

> {%
    client.test("Custom private RSS", function() {
        client.assert(response.status === 200 || response.status === 302 || response.status === 404, "Expected RSS redirect, XML, or cold-start 404");
        if (response.status === 200) {
            client.assert(response.body.includes("<rss"), "Expected RSS XML");
        }
    });
%}

###

### @name updateCustomFeedMismatchFormat
PUT {{baseUrl}}/api/v1/me/feeds/{{customFeedId}}
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "{{customFeedTitle}} updated",
  "formatIds": [{{customFeedMismatchFormatId}}]
}

> {%
    client.test("Point custom feed at mismatch format", function() {
        const mismatchId = client.global.get("customFeedMismatchFormatId");
        if (!mismatchId) {
            client.assert(true, "Skipped — mismatch format was not created");
            return;
        }
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.formatIds.includes(mismatchId), "Expected mismatch format selected");
    });
%}

###

### @name customEnclosureMismatch
GET {{customEnclosureUrl}}
Host: {{tenantAHost}}
Accept: */*

> {%
    client.test("Custom enclosure format mismatch is 404", function() {
        const mismatchId = client.global.get("customFeedMismatchFormatId");
        const episodeSlug = client.global.get("podcastEpisodeSlug");
        if (!mismatchId || !episodeSlug) {
            client.assert(true, "Skipped — mismatch format or episode slug missing");
            return;
        }
        client.assert(response.status === 404, "Expected 404 when the episode is not in this feed's formats");
    });
%}

