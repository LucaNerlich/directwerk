### Directwerk — Custom subscriber feeds (feed builder)
### Prerequisites:
###   02-oauth2.http / 03-auth.http (subscriberAccessToken, tenantAAccessToken, platformAccessToken)
###   06-platform-tenants.http (tenantAId)
###   19-podcast-content.http (podcastFormatId, podcastEpisodeSlug) — 27 creates a second format if needed
###   PODCAST_RSS + SUBSCRIPTION on tenant A. This file activates FEED_BUILDER.
###
### Covers: preview, create/update, duplicate title, missing formats, disable 404,
### rotate, delete default forbidden, enclosure format mismatch 404,
### FEED_BUILDER-off public URL 404 (not JSON 403), cleanup delete.

### @name ensureFeedBuilderEnabled
POST {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/modules/FEED_BUILDER/activate
Authorization: Bearer {{platformAccessToken}}
Accept: application/json

> {%
    client.test("Ensure FEED_BUILDER on", function() {
        client.assert(response.status === 200 || response.status === 409, "Expected 200 or 409");
        if (response.status === 200) {
            client.assert(response.body.data.enabledModules.includes("FEED_BUILDER"), "Expected FEED_BUILDER on");
        }
    });
%}

###

### @name listPublicFormatsForFeedBuilder
GET {{baseUrl}}/api/v1/public/formats
Host: {{tenantAHost}}
Accept: application/json

> {%
    client.test("List public formats", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body.data), "Expected formats array");
        if (!client.global.get("podcastFormatId") && response.body.data.length > 0) {
            client.global.set("podcastFormatId", response.body.data[0].id);
        }
    });
%}

###

### @name createMismatchFormat
< {%
  client.global.set("customFeedMismatchSlug", "mismatch-" + Date.now().toString(36));
%}
POST {{baseUrl}}/api/v1/formats
Host: {{tenantAHost}}
Authorization: Bearer {{tenantAAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "slug": "{{customFeedMismatchSlug}}",
  "name": "Harness Mismatch Format",
  "description": "Used to assert custom-feed enclosure 404 when the episode is not tagged",
  "sortOrder": 90
}

> {%
    client.test("Create mismatch format", function() {
        client.assert(response.status === 201 || response.status === 403, "Expected 201 or 403");
        if (response.status === 201) {
            client.global.set("customFeedMismatchFormatId", response.body.data.id);
        }
    });
%}

###

### @name previewCustomFeed
GET {{baseUrl}}/api/v1/me/feeds/preview?formatIds={{podcastFormatId}}
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Accept: application/json

> {%
    client.test("Preview custom feed by formatIds", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(typeof response.body.data.episodeCount === "number", "Expected episodeCount");
        client.assert(Array.isArray(response.body.data.sampleTitles), "Expected sampleTitles");
    });
%}

###

### @name listMeFeedsBeforeCreate
GET {{baseUrl}}/api/v1/me/feeds
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Accept: application/json

> {%
    client.test("List feeds and capture default id", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body.data) && response.body.data.length > 0, "Expected at least the default feed");
        const defaultFeed = response.body.data.find(feed => feed.isDefault) || response.body.data[0];
        client.global.set("defaultFeedId", defaultFeed.id);
        client.assert(Array.isArray(defaultFeed.formatIds), "Expected formatIds on feed view");
        client.assert(defaultFeed.formatIds.length === 0, "Default feed has no format filter");
    });
%}

###

### @name createCustomFeed
< {%
  client.global.set("customFeedTitle", "Custom-" + Date.now().toString(36));
%}
POST {{baseUrl}}/api/v1/me/feeds
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "{{customFeedTitle}}",
  "formatIds": [{{podcastFormatId}}]
}

> {%
    client.test("Create custom feed", function() {
        client.assert(response.status === 201, "Expected 201");
        client.assert(response.body.data.isDefault === false, "Expected custom feed");
        client.assert(response.body.data.enabled === true, "Expected enabled");
        client.assert(Array.isArray(response.body.data.formatIds) && response.body.data.formatIds.length > 0, "Expected formatIds");
        const feedUrl = response.body.data.url;
        client.assert(typeof feedUrl === "string" && feedUrl.includes("/feeds/") && feedUrl.endsWith(".xml"), "Expected RSS URL");
        client.global.set("customFeedId", response.body.data.id);
        client.global.set("customFeedUrl", feedUrl);
        const episodeSlug = client.global.get("podcastEpisodeSlug") || "missing-episode";
        client.global.set("customEnclosureUrl", feedUrl.replace(/\.xml$/, "/e/" + episodeSlug + ".mp3"));
    });
%}

###

### @name createCustomFeedDuplicateTitle
POST {{baseUrl}}/api/v1/me/feeds
Host: {{tenantAHost}}
Authorization: Bearer {{subscriberAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "{{customFeedTitle}}",
  "formatIds": [{{podcastFormatId}}]
}

> {%
    client.test("Duplicate custom title", function() {
        client.assert(response.status === 409, "Expected 409");
        client.assert(response.body.errors[0].code === "FEED_TITLE_DUPLICATE", "Expected FEED_TITLE_DUPLICATE");
    });
%}

