# Directwerk environment variables
# Copy to `.env` in this directory. With profile `local`, Spring Boot loads it automatically
# via spring.config.import (see application-local.yaml). Docker Compose also reads `.env`
# for variable substitution. Do not commit `.env`.
#
# Build and deploy guide: docs/build-and-deploy.md

# -----------------------------------------------------------------------------
# Runtime profile (set explicitly — no default in application.yaml)
# Options: local | stage | prod
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Default host port is 5433 so Directwerk does not clash with a local Postgres on 5432.
# Change DIRECTWERK_POSTGRES_PORT if that port is taken too (e.g. 5434).
# SPRING_DATASOURCE_PASSWORD is required — used by Compose, Spring, Flyway CLI, and
# scripts/setup-local-database.sql. Do not commit `.env`.
# Bootstrap a local Postgres 18/19 instance once (superuser; export vars for psql first):
#   set -a && source .env && set +a
#   psql -U postgres -f scripts/setup-local-database.sql
# Connect with a custom port:
#   psql -U myuser -d mydatabase -p "${DIRECTWERK_POSTGRES_PORT:-5433}"
# -----------------------------------------------------------------------------
DIRECTWERK_POSTGRES_PORT=5433
SPRING_DATASOURCE_USERNAME=myuser
SPRING_DATASOURCE_PASSWORD=
# Optional — local profile builds the JDBC URL from DIRECTWERK_POSTGRES_PORT when unset
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/mydatabase

# -----------------------------------------------------------------------------
# Flyway CLI (./gradlew flywayMigrate — optional, separate from app startup)
# Gradle does not auto-load .env; run `set -a && source .env && set +a` first, or export vars.
# Uses DIRECTWERK_POSTGRES_PORT and SPRING_DATASOURCE_PASSWORD when FLYWAY_URL /
# FLYWAY_PASSWORD are unset. flywayClean is allowed only when SPRING_PROFILES_ACTIVE=local.
# -----------------------------------------------------------------------------
# FLYWAY_URL=jdbc:postgresql://localhost:5433/mydatabase
FLYWAY_USER=myuser

# -----------------------------------------------------------------------------
# OAuth2 / JWT security (directwerk.security.*)
# -----------------------------------------------------------------------------

# Token issuer URL. Local default is set in application-local.yaml.
# Stage/prod: must be HTTPS, e.g. https://api.example.com
DIRECTWERK_ISSUER=http://localhost:8080

# OAuth client IDs (public defaults)
DIRECTWERK_PLATFORM_CLIENT_ID=directwerk-platform-admin
DIRECTWERK_TENANT_CLIENT_ID=directwerk-tenant-frontend

# OAuth client secrets — required for local/stage/prod; tests inject via @TestPropertySource or CI env
DIRECTWERK_PLATFORM_CLIENT_SECRET=
DIRECTWERK_TENANT_CLIENT_SECRET=

# JWT audience claim validated on resource-server requests
# Configured in application.yaml as `directwerk-api` (not env-driven today)

# RSA signing keys for JWT (PEM). Leave empty locally to generate ephemeral keys at startup.
# Stage/prod: required — paste PEM content or use \n for line breaks in a single line.
DIRECTWERK_JWT_PRIVATE_KEY=
DIRECTWERK_JWT_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Account registration (directwerk.account.*)
# Set to false locally to register and log in without email verification.
# expose-dev-tokens is forced true on profile=local and must stay false in prod.
# -----------------------------------------------------------------------------
DIRECTWERK_ACCOUNT_EMAIL_VERIFICATION_REQUIRED=false
# DIRECTWERK_ACCOUNT_EXPOSE_DEV_TOKENS=false

# -----------------------------------------------------------------------------
# First platform admin bootstrap (any profile — PlatformAdminBootstrap)
# Both must be set together. Runs only when no platform admin exists yet.
# Prefer DevDataInitializer seeds on profile=local; use this for docker/stage/prod.
# -----------------------------------------------------------------------------
# DIRECTWERK_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@example.com
# DIRECTWERK_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Local profile only (DevDataInitializer seed users)
# Platform admin credentials are separate from tenant seed users.
# Tenant users (admin-a, admin-b, editor, subscriber flows) use DIRECTWERK_DEV_SEED_PASSWORD.
# Only applied when creating users without an existing password hash.
# -----------------------------------------------------------------------------
DIRECTWERK_DEV_PLATFORM_ADMIN_EMAIL=platform-admin@directwerk.local
DIRECTWERK_DEV_PLATFORM_ADMIN_PASSWORD=ChangeMe-Dev-Seed!
DIRECTWERK_DEV_SEED_PASSWORD=ChangeMe-Dev-Seed!

# -----------------------------------------------------------------------------
# Optional server override
# -----------------------------------------------------------------------------
# SERVER_PORT=8080
# DIRECTWERK_APP_PORT=8080

# -----------------------------------------------------------------------------
# Email (queued jobs + pluggable transport + directwerk.email.*)
# Local defaults target Mailpit started via compose.yaml (SMTP 1025, UI 8025).
# provider=smtp uses Spring Mail (Mailpit locally, Mailgun SMTP or any relay in prod).
# provider=none keeps templates/jobs but never delivers — use until an ESP is wired.
# To add Mailgun HTTP / Resend later: implement EmailSender and extend the provider list.
# -----------------------------------------------------------------------------
DIRECTWERK_EMAIL_PROVIDER=smtp
DIRECTWERK_EMAIL_FROM=noreply@directwerk.local
DIRECTWERK_EMAIL_FROM_NAME=Directwerk
# Tenant auth links (accept-invite, reset-password, verify-email) — served by directwerk-web locally.
DIRECTWERK_EMAIL_STUDIO_BASE_URL=http://localhost:3004
DIRECTWERK_EMAIL_ADMIN_BASE_URL=http://localhost:3001
# DIRECTWERK_EMAIL_ACCEPT_INVITE_PATH=/accept-invite
# DIRECTWERK_EMAIL_RESET_PASSWORD_PATH=/reset-password
# DIRECTWERK_EMAIL_VERIFY_EMAIL_PATH=/verify-email
# DIRECTWERK_EMAIL_DELIVERY_RETENTION_DAYS=7

# Homepage contact form (public POST /api/v1/public/contact)
# DIRECTWERK_CONTACT_FORM_ENABLED=true
# DIRECTWERK_CONTACT_INBOX_EMAIL=hello@directwerk.de
# DIRECTWERK_CONTACT_RATE_LIMIT_PER_MINUTE=5
# DIRECTWERK_ALTCHA_HMAC_KEY=generate-a-long-random-secret
# DIRECTWERK_ALTCHA_EXPIRES_SECONDS=300

DIRECTWERK_MAIL_HOST=localhost
DIRECTWERK_MAIL_PORT=1025
# DIRECTWERK_MAIL_USERNAME=
# DIRECTWERK_MAIL_PASSWORD=
DIRECTWERK_MAIL_SMTP_AUTH=false
DIRECTWERK_MAIL_SMTP_STARTTLS=false
DIRECTWERK_MAILPIT_SMTP_PORT=1025
DIRECTWERK_MAILPIT_UI_PORT=8025

# Mailgun SMTP (stage/prod example — uncomment and set values)
# DIRECTWERK_MAIL_HOST=smtp.mailgun.org
# DIRECTWERK_MAIL_PORT=587
# DIRECTWERK_MAIL_USERNAME=postmaster@mg.yourdomain.com
# DIRECTWERK_MAIL_PASSWORD=
# DIRECTWERK_MAIL_SMTP_AUTH=true
# DIRECTWERK_MAIL_SMTP_STARTTLS=true
# DIRECTWERK_EMAIL_FROM=noreply@yourdomain.com
# Prod also requires HTTPS:
# DIRECTWERK_EMAIL_STUDIO_BASE_URL=https://studio.example.com
# DIRECTWERK_EMAIL_ADMIN_BASE_URL=https://admin.example.com

# -----------------------------------------------------------------------------
# Background job queue (directwerk.queue.*) — defaults are fine for local
# See docs/jobs-and-email.md. Set WORKER_ID per pod when scaling horizontally.
# -----------------------------------------------------------------------------
# DIRECTWERK_QUEUE_ENABLED=true
# DIRECTWERK_QUEUE_WORKER_ID=
# DIRECTWERK_QUEUE_POLL_INTERVAL_MS=5000
# DIRECTWERK_QUEUE_CLAIM_LIMIT=10
# DIRECTWERK_QUEUE_LEASE_SECONDS=60
# DIRECTWERK_QUEUE_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Analytics (Umami)
# -----------------------------------------------------------------------------
# Enables server-side episode download/stream events. The Umami host is platform
# config only and must be HTTPS; tenants only configure their Umami website ID.
# DIRECTWERK_ANALYTICS_ENABLED=false
# DIRECTWERK_ANALYTICS_UMAMI_HOST_URL=https://umami.pnn-it.de
# DIRECTWERK_ANALYTICS_USER_AGENT=Directwerk/1.0

# -----------------------------------------------------------------------------
# Docker Compose profiles
# -----------------------------------------------------------------------------
# Uncomment when you mostly run the full stack (app in Docker). Then bare
# `docker compose up/down` include the `directwerk` service — avoids leaving
# the app running after `docker compose down` (network "still in use").
# Leave commented for host bootRun + infra-only Compose (`docker compose up -d`).
# COMPOSE_PROFILES=stack

# -----------------------------------------------------------------------------
# Object storage (directwerk.storage.*) — Hetzner or Bunny S3-compatible
# Create bucket `directwerk-dev` once; enable S3 compatibility on Bunny at zone creation.
# REQUIRED: DIRECTWERK_STORAGE_ENABLED=true to wire S3Client, UploadApi, and health check.
# Bunny: path-style + region code de|uk|se|… (see https://docs.bunny.net/storage/s3). Hetzner: typically virtual-hosted.
# Alias names S3_* also work.
# -----------------------------------------------------------------------------
# DIRECTWERK_STORAGE_ENABLED=true
# DIRECTWERK_STORAGE_PROVIDER=bunny
# DIRECTWERK_STORAGE_REGION=de
# DIRECTWERK_STORAGE_BUCKET=your-zone-name
# DIRECTWERK_STORAGE_ENDPOINT=https://de-s3.storage.bunnycdn.com
# DIRECTWERK_STORAGE_FORCE_PATH_STYLE=true
# DIRECTWERK_STORAGE_ACCESS_KEY=your-zone-name
# DIRECTWERK_STORAGE_SECRET_KEY=your-zone-password
# DIRECTWERK_STORAGE_PUBLIC_CDN_BASE_URL=https://your-pullzone.b-cdn.net
# Staging objects are purged app-side (Bunny has no lifecycle rules): age threshold + sweep interval.
# DIRECTWERK_STORAGE_STAGING_LIFECYCLE_HOURS=24
# DIRECTWERK_STORAGE_STAGING_CLEANUP_INTERVAL_MS=3600000
# Private PZ (Token Auth) — when both set, paid downloads use Bunny Advanced tokens instead of S3 presign.
# DIRECTWERK_STORAGE_PRIVATE_CDN_BASE_URL=https://your-private-pullzone.b-cdn.net
# DIRECTWERK_STORAGE_CDN_TOKEN_AUTH_KEY=
# Optional Bunny account AccessKey for Purge URL on public asset delete (not the S3 zone password).
# DIRECTWERK_STORAGE_CDN_PURGE_API_KEY=
# DIRECTWERK_STORAGE_CDN_PURGE_API_BASE_URL=https://api.bunny.net
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_CDN_BASE_URL=

# -----------------------------------------------------------------------------
# Reverse proxy (prod behind Coolify / Traefik)
# -----------------------------------------------------------------------------
# DIRECTWERK_FORWARD_HEADERS_STRATEGY=framework

# -----------------------------------------------------------------------------
# Stripe Connect (directwerk.stripe.*) — server-only, never expose to browsers
# Leave blank locally to keep checkout/onboard returning 501 STRIPE_NOT_IMPLEMENTED.
# Webhooks: stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_CLIENT_ID=ca_...
