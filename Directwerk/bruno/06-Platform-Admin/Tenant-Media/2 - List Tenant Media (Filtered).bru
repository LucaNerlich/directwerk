meta {
  name: 2 - List Tenant Media (Filtered)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/media
  body: none
  auth: inherit
}

params:query {
  assetType: IMAGE
  status: READY
  limit: 20
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
  });
}
