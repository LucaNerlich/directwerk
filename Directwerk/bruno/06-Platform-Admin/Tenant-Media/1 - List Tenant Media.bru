meta {
  name: 1 - List Tenant Media
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/media
  body: none
  auth: inherit
}

params:query {
  limit: 50
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
  });
}

docs {
  limit is 1..100 (validated via @Min/@Max + @Validated): out-of-range values
  return 400 VALIDATION_ERROR in the standard envelope.
}
