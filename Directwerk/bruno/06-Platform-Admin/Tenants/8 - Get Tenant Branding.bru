meta {
  name: Get Tenant Branding
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/branding
  body: none
  auth: inherit
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.umamiWebsiteId !== undefined).to.equal(true);
    expect(res.body.data.umamiHostUrl !== undefined).to.equal(true);
  });
}

docs {
  Read-only branding incl. Umami website ID + host for platform ops debugging.
}
