meta {
  name: List Audit Events
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/platform/audit
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 20
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
  });

  test("returns paginated audit payload", function() {
    expect(res.body.data).to.be.an("array");
    expect(res.body.metadata.totalElements).to.be.a("number");
    expect(res.body.metadata.page).to.equal(0);
    expect(res.body.metadata.size).to.equal(20);
  });
}
