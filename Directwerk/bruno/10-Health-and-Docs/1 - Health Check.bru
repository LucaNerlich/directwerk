meta {
  name: 1 - Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/actuator/health
  body: none
  auth: none
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
  });
  test("status is UP", function() {
    expect(res.body.status).to.equal("UP");
  });
}
