meta {
  name: 1 - List Digital Publications
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/digital-publications
  body: none
  auth: inherit
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
  });
  test("returns an array of publications", function() {
    expect(res.body.data).to.be.an("array");
  });
}

docs {
  Lists bonus DigitalPublication rows for the tenant (BONUS_CONTENT module).
