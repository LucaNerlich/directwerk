meta {
  name: Site Config (Tenant A)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/public/site-config
  body: none
  auth: none
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
    if (res.body.data.analytics !== null && res.body.data.analytics !== undefined) {
      expect(res.body.data.analytics).to.have.property("umamiWebsiteId");
      expect(res.body.data.analytics).to.have.property("umamiHostUrl");
      expect(res.body.data.analytics).to.have.property("umamiScriptUrl");
    }
  });
}
