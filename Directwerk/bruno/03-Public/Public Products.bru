meta {
  name: Public Products
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/public/products
  body: none
  auth: none
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
    expect(res.body.data).to.be.an("array");
    if (res.body.data.length > 0) {
      expect(res.body.data[0]).to.have.property("description");
      expect(res.body.data[0]).to.have.property("priceCents");
      expect(res.body.data[0]).to.have.property("currency");
      expect(res.body.data[0]).to.have.property("billingInterval");
    }
  });
}

docs {
  GET /api/v1/public/products — PublicSubscriptionProductController.
  Active catalog including description, priceCents, currency, billingInterval.
  Empty array if the SUBSCRIPTION module is off for the tenant.
}
