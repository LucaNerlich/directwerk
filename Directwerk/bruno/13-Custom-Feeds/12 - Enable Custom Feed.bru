meta {
  name: 12 - Enable Custom Feed
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/v1/me/feeds/{{customFeedId}}/enabled
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "enabled": true
  }
}

tests {
  test("re-enables the custom feed", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.enabled).to.equal(true);
  });
}
