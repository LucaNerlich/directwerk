meta {
  name: 8 - Preview Custom Feed By Id
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/me/feeds/{{customFeedId}}/preview
  body: none
  auth: inherit
}

tests {
  test("previews an owned custom feed", function() {
    expect([200, 403, 404, 409]).to.include(res.getStatus());
    if (res.getStatus() === 200) {
      expect(res.body.data.episodeCount).to.be.a("number");
    }
    if (res.getStatus() === 409) {
      expect(res.body.errors[0].code).to.equal("DEFAULT_FEED_NOT_FILTERABLE");
    }
  });
}
