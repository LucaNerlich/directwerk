meta {
  name: 8 - Preview Custom Feed By Id
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/me/feeds/{{customFeedId}}/preview
  body: none
  auth: inherit
}

tests {
  test("previews an owned custom feed", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.episodeCount).to.be.a("number");
  });
}
