meta {
  name: 17 - Delete Custom Feed
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}/api/v1/me/feeds/{{customFeedId}}
  body: none
  auth: inherit
}

tests {
  test("deletes the custom feed", function() {
    expect([200, 403, 404]).to.include(res.getStatus());
    if (res.getStatus() === 200) {
      expect(res.body.data.id).to.equal(Number(bru.getVar("customFeedId")));
      expect(res.body.data.isDefault).to.equal(false);
    }
  });
}

docs {
  Withdraws the S3 snapshot then drops the row. Allowed without FEED_BUILDER.
}
