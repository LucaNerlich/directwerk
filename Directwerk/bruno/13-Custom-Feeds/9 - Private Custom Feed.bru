meta {
  name: 9 - Private Custom Feed
  type: http
  seq: 9
}

get {
  url: {{customFeedUrl}}
  body: none
  auth: none
}

headers {
  Accept: application/rss+xml
}

tests {
  test("serves custom private RSS", function() {
    const status = res.getStatus();
    expect([200, 302, 403, 404]).to.include(status);
    if (status === 200) {
      expect(res.body).to.include("<rss");
    }
    if (status === 403) {
      expect(res.body.errors[0].code).to.equal("FEATURE_NOT_ENABLED");
    }
  });
}

docs {
  Uses the absolute URL captured by Create Custom Feed. Channel title is the feed title.
  Empty XML is valid. Requires PODCAST_RSS + FEED_BUILDER.
}
