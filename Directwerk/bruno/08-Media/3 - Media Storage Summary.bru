meta {
  name: 3 - Media Storage Summary
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/v1/media/storage-summary
  body: none
  auth: inherit
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
  });
  test("exposes totals and buckets", function() {
    expect(res.body.data).to.have.property("totalAssets");
    expect(res.body.data).to.have.property("totalBytes");
    expect(res.body.data.buckets).to.be.an("array");
  });
}

docs {
  Aggregate media storage usage for the studio overview widgets.
}
