meta {
  name: 2 - List Media
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/media
  body: none
  auth: inherit
}

docs {
  Default list excludes tombstoned assets (ARCHIVED, PENDING_DELETE). Pass ?status=ARCHIVED to inspect deleted rows.
}

params:query {
  limit: 20
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200 || res.getStatus() === 503).to.equal(true);
  });
}
