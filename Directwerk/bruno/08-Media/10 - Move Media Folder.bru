meta {
  name: 10 - Move Media Folder
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/media/folders/{{mediaFolderId}}/move
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "parentId": null
  }
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200 || res.getStatus() === 404 || res.getStatus() === 503).to.equal(true);
  });
}

docs {
  Null parentId moves the folder to the library root. Self/cycle parents and moves beyond depth 8 are rejected with 400.
}
