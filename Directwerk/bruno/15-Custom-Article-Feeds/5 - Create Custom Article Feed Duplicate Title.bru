meta {
  name: 5 - Create Custom Article Feed Duplicate Title
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/me/article-feeds
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "{{customArticleFeedTitle}}",
    "categoryIds": [{{articleCategoryId}}]
  }
}

tests {
  test("rejects a duplicate custom title", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.body.errors[0].code).to.equal("FEED_TITLE_DUPLICATE");
  });
}

docs {
  Custom titles are unique per user+tenant (case-insensitive).
}
