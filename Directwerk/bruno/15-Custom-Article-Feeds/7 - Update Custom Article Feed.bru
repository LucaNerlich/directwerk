meta {
  name: 7 - Update Custom Article Feed
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/v1/me/article-feeds/{{customArticleFeedId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "{{customArticleFeedTitle}} updated",
    "categoryIds": [{{articleCategoryId}}]
  }
}

tests {
  test("updates title and categories", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.title).to.include("updated");
    expect(res.body.data.isDefault).to.equal(false);
  });
}

docs {
  PUT /api/v1/me/article-feeds/{id} — cannot filter the default feed (DEFAULT_FEED_NOT_FILTERABLE).
}
