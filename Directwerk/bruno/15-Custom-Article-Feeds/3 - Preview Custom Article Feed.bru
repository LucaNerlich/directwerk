meta {
  name: 3 - Preview Custom Article Feed
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/me/article-feeds/preview?categoryIds={{articleCategoryId}}
  body: none
  auth: inherit
}

tests {
  test("returns preview or module/category error", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.articleCount).to.be.a("number");
    expect(res.body.data.sampleTitles).to.be.an("array");
  });
}

docs {
  GET /api/v1/me/article-feeds/preview?categoryIds= — article count after entitlement + category match.
}
