meta {
  name: 2 - List Public Article Categories
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/public/article-categories
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() === 200 && Array.isArray(res.body.data) && res.body.data.length > 0 && !bru.getVar("articleCategoryId")) {
    bru.setVar("articleCategoryId", res.body.data[0].id);
  }
}

tests {
  test("returns categories", function() {
    expect(res.getStatus()).to.equal(200);
    expect(Array.isArray(res.body.data)).to.equal(true);
  });
}

docs {
  Captures articleCategoryId when no earlier folder has set it.
}
