meta {
  name: 16 - Delete Custom Article Feed
  type: http
  seq: 16
}

delete {
  url: {{baseUrl}}/api/v1/me/article-feeds/{{customArticleFeedId}}
  body: none
  auth: inherit
}

tests {
  test("deletes the custom feed", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.id).to.equal(Number(bru.getVar("customArticleFeedId")));
    expect(res.body.data.isDefault).to.equal(false);
  });
}

docs {
  Withdraws the S3 snapshot then drops the row. Allowed without ARTICLE_FEED_BUILDER.
}
