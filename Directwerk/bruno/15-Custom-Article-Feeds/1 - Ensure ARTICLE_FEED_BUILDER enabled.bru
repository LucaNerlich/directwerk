meta {
  name: 1 - Ensure ARTICLE_FEED_BUILDER enabled
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/modules/ARTICLE_FEED_BUILDER/activate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{platformAccessToken}}
}

tests {
  test("ARTICLE_FEED_BUILDER enabled", function() {
    expect(res.getStatus() === 200 || res.getStatus() === 409).to.equal(true);
    if (res.getStatus() === 200) {
      expect(res.body.data.enabledModules.includes("ARTICLE_FEED_BUILDER")).to.equal(true);
    }
  });
}

docs {
  Activates ARTICLE_FEED_BUILDER on tenant A (needs ARTICLE_RSS + SUBSCRIPTION).
}
