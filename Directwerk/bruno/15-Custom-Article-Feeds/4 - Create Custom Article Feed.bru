meta {
  name: 4 - Create Custom Article Feed
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/me/article-feeds
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:pre-request {
  bru.setVar("customArticleFeedTitle", "Custom-" + Date.now().toString(36));
}

body:json {
  {
    "title": "{{customArticleFeedTitle}}",
    "categoryIds": [{{articleCategoryId}}]
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("customArticleFeedId", res.body.data.id);
    bru.setVar("customArticleFeedUrl", res.body.data.url);
  }
}

tests {
  test("creates a custom article feed", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.data.isDefault).to.equal(false);
    expect(res.body.data.enabled).to.equal(true);
    expect(res.body.data.categoryIds).to.be.an("array").that.is.not.empty;
    expect(res.body.data.url).to.include("/feeds/");
  });
}

docs {
  POST /api/v1/me/article-feeds — Category-only custom private RSS. Max 5 per user/tenant.
}
