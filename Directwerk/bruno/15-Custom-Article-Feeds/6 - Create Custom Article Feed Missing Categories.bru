meta {
  name: 6 - Create Custom Article Feed Missing Categories
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/me/article-feeds
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Missing categories",
    "categoryIds": []
  }
}

tests {
  test("requires at least one category", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.body.errors[0].code).to.equal("FEED_CATEGORIES_REQUIRED");
  });
}
