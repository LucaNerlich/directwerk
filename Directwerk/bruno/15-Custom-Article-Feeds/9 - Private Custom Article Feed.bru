meta {
  name: 9 - Private Custom Article Feed
  type: http
  seq: 9
}

get {
  url: {{customArticleFeedUrl}}
  body: none
  auth: none
}

headers {
  Accept: application/rss+xml
}

tests {
  test("serves custom private RSS", async function() {
    let status = res.getStatus();
    let attempt = 0;
    const maxAttempts = 5;

    while (attempt < maxAttempts && status !== 200 && status !== 302) {
      await new Promise(resolve => setTimeout(resolve, 1000));
      const retryResponse = await fetch(bru.getVar("customArticleFeedUrl"));
      status = retryResponse.status;
      attempt++;
    }

    expect([200, 302]).to.include(status);
    if (status === 200) {
      expect(res.body).to.include("<rss");
    }
  });
}

docs {
  Uses the absolute URL captured by Create Custom Article Feed. Channel title is the feed title.
  Empty XML is valid. Requires ARTICLE_RSS + ARTICLE_FEED_BUILDER.
}
