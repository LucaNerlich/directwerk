meta {
  name: 15 - Private Custom Article Feed ARTICLE_FEED_BUILDER off
  type: http
  seq: 15
}

get {
  url: {{customArticleFeedUrl}}
  body: none
  auth: none
}

headers {
  Accept: application/rss+xml
}

script:pre-request {
  function platformRequest(opts) {
    return new Promise((resolve, reject) => {
      bru.sendRequest(opts, (err, resp) => {
        if (err) return reject(err);
        resolve(resp);
      });
    });
  }
  const baseUrl = bru.getEnvVar("baseUrl");
  const tenantAId = bru.getVar("tenantAId") || bru.getEnvVar("tenantAId");
  const token = bru.getVar("platformAccessToken") || bru.getEnvVar("platformAccessToken");
  await platformRequest({
    url: baseUrl + "/api/v1/platform/tenants/" + tenantAId + "/modules/ARTICLE_FEED_BUILDER",
    method: "DELETE",
    headers: {
      Authorization: "Bearer " + token,
      Accept: "application/json"
    }
  });
}

script:post-response {
  function platformRequest(opts) {
    return new Promise((resolve, reject) => {
      bru.sendRequest(opts, (err, resp) => {
        if (err) return reject(err);
        resolve(resp);
      });
    });
  }
  const baseUrl = bru.getEnvVar("baseUrl");
  const tenantAId = bru.getVar("tenantAId") || bru.getEnvVar("tenantAId");
  const token = bru.getVar("platformAccessToken") || bru.getEnvVar("platformAccessToken");
  try {
    await platformRequest({
      url: baseUrl + "/api/v1/platform/tenants/" + tenantAId + "/modules/ARTICLE_FEED_BUILDER/activate",
      method: "POST",
      headers: {
        Authorization: "Bearer " + token,
        Accept: "application/json"
      }
    });
  } catch (error) {
    console.error("Failed to restore ARTICLE_FEED_BUILDER after custom feed gate check", error);
    throw error;
  }
}

tests {
  test("custom feed is 404 (not JSON 403) when ARTICLE_FEED_BUILDER is off", function() {
    expect(res.getStatus()).to.equal(404);
  });
}

docs {
  Readers must see a 404 no-store, not FEATURE_NOT_ENABLED JSON, when ARTICLE_FEED_BUILDER is off.
  Restores ARTICLE_FEED_BUILDER in post-response even when the assertion fails.
}
