meta {
  name: 8 - Preview Custom Article Feed By Id
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/me/article-feeds/{{customArticleFeedId}}/preview
  body: none
  auth: inherit
}

tests {
  test("previews an owned custom feed", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.articleCount).to.be.a("number");
  });
}
