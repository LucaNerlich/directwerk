meta {
  name: Public Enclosure
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/feeds/{{tenantASlug}}/e/{{podcastEpisodeSlug}}.mp3
  body: none
  auth: none
}

headers {
  Accept: */*
}

tests {
  test("returns expected status", function() {
    const status = res.getStatus();
    expect(status === 302 || status === 403 || status === 404).to.equal(true);
    if (status === 403) {
      expect(res.body.errors[0].code).to.equal("FEATURE_NOT_ENABLED");
    }
  });
}

docs {
  RssFeedController public enclosure proxy. Requires PODCAST + PODCAST_RSS.
}
