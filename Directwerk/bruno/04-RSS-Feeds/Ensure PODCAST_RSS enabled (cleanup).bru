meta {
  name: Ensure PODCAST_RSS enabled (cleanup)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/platform/tenants/{{tenantAId}}/modules/PODCAST_RSS/activate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{platformAccessToken}}
}

tests {
  test("PODCAST_RSS enabled after gate checks", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.enabledModules.includes("PODCAST_RSS")).to.equal(true);
  });
}

docs {
  Belt-and-suspenders cleanup. Each off-request already restores in post-response;
  this final activate still runs if the folder is executed to completion.
}
