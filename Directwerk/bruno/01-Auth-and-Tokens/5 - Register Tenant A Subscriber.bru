meta {
  name: 5 - Register Tenant A Subscriber
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Host: {{tenantAHost}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{subscriberEmail}}",
    "password": "{{seedPassword}}",
    "name": "Test Subscriber"
  }
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 201 || res.getStatus() === 409).to.equal(true);
  });
  test("201 first run, 409 if already registered", function() {});
}
