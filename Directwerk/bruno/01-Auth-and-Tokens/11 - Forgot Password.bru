meta {
  name: 11 - Forgot Password
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: none
}

headers {
  Host: {{tenantAHost}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{subscriberEmail}}"
  }
}

script:post-response {
  bru.setVar("passwordResetToken", res.body.data && res.body.data.devResetToken);
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 202).to.equal(true);
  });
}

docs {
  devResetToken only present when directwerk.account.expose-dev-tokens=true (local profile).
}
