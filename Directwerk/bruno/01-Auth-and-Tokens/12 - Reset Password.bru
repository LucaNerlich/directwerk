meta {
  name: 12 - Reset Password
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/auth/reset-password
  body: json
  auth: none
}

headers {
  Host: {{tenantAHost}}
  Content-Type: application/json
}

body:json {
  {
    "token": "{{passwordResetToken}}",
    "newPassword": "{{seedPassword}}"
  }
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200 || res.getStatus() === 400).to.equal(true);
  });
}
