meta {
  name: 1 - List Episodes
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/episodes
  body: none
  auth: inherit
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
  });

  test("episode views expose coverImageUrl", function() {
    const data = res.body && res.body.data;
    const episodeId = Number(bru.getVar("podcastEpisodeId"));
    const episode = Array.isArray(data)
      ? data.find((item) => item.id === episodeId)
      : undefined;
    expect(episode).to.not.equal(undefined);
    expect('coverImageUrl' in episode).to.equal(true);
  });
}
