meta {
  name: 1 - Preview Feed
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/podcast/import/preview
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "feedUrl": "https://example.com/podcast.xml"
  }
}

tests {
  test("returns expected status", function() {
    expect([200, 400, 403]).to.include(res.getStatus());
  });
}

docs {
  Parses a public RSS feed and returns channel + episode metadata. Does not download audio or images.
  A live public URL is required for 200; example.com is expected to fail parse/download with RSS_FEED_*.
}
