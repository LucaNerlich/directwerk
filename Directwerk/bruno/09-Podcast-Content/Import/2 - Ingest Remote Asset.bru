meta {
  name: 2 - Ingest Remote Asset
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/podcast/import/assets
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sourceUrl": "https://example.com/cover.jpg",
    "assetType": "IMAGE",
    "visibility": "PUBLIC"
  }
}

tests {
  test("returns expected status", function() {
    expect([201, 400, 403, 503]).to.include(res.getStatus());
  });
}

docs {
  Streams a remote image or audio file into tenant S3. Rejects private hosts (REMOTE_URL_FORBIDDEN).
}
