meta {
  name: 2b - Ingest Remote Asset Async
  type: http
  seq: 2.5
}

post {
  url: {{baseUrl}}/api/v1/podcast/import/assets
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sourceUrl": "https://example.com/cover.jpg",
    "assetType": "IMAGE",
    "visibility": "PUBLIC",
    "waitForCompletion": false
  }
}

tests {
  test("returns expected status", function() {
    expect([202, 400, 403, 503]).to.include(res.getStatus());
  });
}

docs {
  Starts a background remote ingest and returns a PENDING asset immediately.
  Poll GET /api/v1/media/{id} for bytesTransferred until status=READY.
}
