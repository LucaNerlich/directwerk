meta {
  name: 2 - Get Series
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/series/{{podcastSeriesId}}
  body: none
  auth: inherit
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200 || res.getStatus() === 404).to.equal(true);
  });
}

docs {
  Response now includes rssUrl (null unless PODCAST_RSS is enabled for the tenant).
}
