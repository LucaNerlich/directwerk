meta {
  name: 3 - Update Category
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/categories/{{podcastCategoryId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "slug": "{{podcastCategorySlug}}",
    "name": "Harness Category Updated",
    "active": true
  }
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
  });
}
