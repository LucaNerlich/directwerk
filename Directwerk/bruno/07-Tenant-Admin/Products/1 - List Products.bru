meta {
  name: 1 - List Products
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/tenant/products
  body: none
  auth: inherit
}

vars:post-response {
  supporterProductId: (res.body.data.find(p => p.slug === "supporter") || {}).id
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
    expect(res.body.data).to.be.an("array");
    if (res.body.data.length > 0) {
      expect(res.body.data[0]).to.have.property("priceCents");
      expect(res.body.data[0]).to.have.property("currency");
      expect(res.body.data[0]).to.have.property("billingInterval");
      expect(res.body.data[0]).to.have.property("stripeProductId");
      expect(res.body.data[0]).to.have.property("stripePriceId");
    }
  });
}

docs {
  Captures supporterProductId if a 'supporter' product happens to be seeded (optional, used by Subscriptions/1 - Grant Subscription).
}
