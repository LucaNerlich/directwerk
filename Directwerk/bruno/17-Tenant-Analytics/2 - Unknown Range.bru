meta {
  name: 2 - Unknown Range
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/tenant/analytics/stats/13d
  body: none
  auth: inherit
}

tests {
  test("rejects unknown range", function() {
    expect(res.getStatus() === 400).to.equal(true);
    expect(res.body.errors[0].code).to.equal("ANALYTICS_RANGE_INVALID");
  });
}
