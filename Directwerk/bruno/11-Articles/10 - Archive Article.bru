meta {
  name: 10 - Archive Article
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/articles/{{articleId}}/archive
  body: none
  auth: inherit
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200 || res.getStatus() === 400 || res.getStatus() === 404).to.equal(true);
  });
}

docs {
  Requires a PUBLISHED article — run 6 - Publish Article (or 6b) first.
  400 INVALID_PUBLICATION_TRANSITION if status is not PUBLISHED.
}
