meta {
  name: 4 - Bulk Import Articles
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/articles/import/bulk
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "feedUrl": "https://example.com/articles.xml",
    "accessPolicy": "FREE",
    "importHero": true,
    "importInlineImages": true
  }
}

tests {
  test("returns expected status", function() {
    expect([202, 400, 403]).to.include(res.getStatus());
  });
}

docs {
  Queues article-rss-bulk-import for every not-yet-imported item. Emails a summary when finished.
}
