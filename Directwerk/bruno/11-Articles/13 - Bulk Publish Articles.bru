meta {
  name: 13 - Bulk Publish Articles
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/articles/bulk/publish
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "ids": [{{articleId}}],
    "notifySubscribers": false
  }
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200 || res.getStatus() === 400 || res.getStatus() === 404 || res.getStatus() === 409).to.equal(true);
  });
  test("returns one view per id on success", function() {
    if (res.getStatus() === 200) {
      expect(res.body.data.length).to.equal(1);
    }
  });
}

docs {
  Atomic bulk publish: all ids in one transaction with a single RSS refresh.
  Accepts 1-100 ids; duplicates are published once.
  400 ARTICLE_VALIDATION_FAILED if title or body is missing after sanitization.
  409 PUBLICATION_INVALID_TRANSITION when an article is not publishable.
  Run 13 before 14 (publish → unpublish).
}
