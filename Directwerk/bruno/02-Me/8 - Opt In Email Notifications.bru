meta {
  name: 8 - Opt In Email Notifications
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v1/me/notification-preferences
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "emailNotificationsEnabled": true
  }
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
    expect(res.body.data.emailNotificationsEnabled).to.equal(true);
    expect(typeof res.body.data.emailNotifyAvailable).to.equal("boolean");
  });
}

docs {
  Requires EMAIL_NOTIFY on the tenant and platform email delivery enabled (emailNotifyAvailable).
  Returns 403 FEATURE_NOT_ENABLED when opting in while emailNotifyAvailable is false.
}
