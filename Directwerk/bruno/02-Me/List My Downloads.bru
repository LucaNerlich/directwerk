meta {
  name: List My Downloads
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/me/downloads
  body: none
  auth: inherit
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200 || res.getStatus() === 403).to.equal(true);
  });
  test("returns downloads array when entitled", function() {
    if (res.getStatus() === 200) {
      expect(Array.isArray(res.body.data)).to.equal(true);
    }
  });
}

docs {
  Lists entitled READY digital assets with signed download URLs (cap 50).
  403 if DIGITAL_CONTENT or SUBSCRIPTION module is off for the tenant.
}
