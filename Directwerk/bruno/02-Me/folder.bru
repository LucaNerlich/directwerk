meta {
  name: 02-Me
  seq: 2
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{subscriberAccessToken}}
}

headers {
  Host: {{tenantAHost}}
}

docs {
  Requires 01-Auth-and-Tokens/6 (Tenant A Subscriber Login) to have run.
  Includes notification preference opt-in for EMAIL_NOTIFY content emails
  and MeBillingController checkout + Customer Portal (201 when Stripe is live,
  409/501 when Connect or platform keys are missing).
  List My Downloads returns entitled digital assets (DIGITAL_CONTENT + SUBSCRIPTION).
  Custom feed CRUD lives in 13-Custom-Feeds (needs FEED_BUILDER + a format from 09).
}
