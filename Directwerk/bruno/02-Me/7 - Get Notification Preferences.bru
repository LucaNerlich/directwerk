meta {
  name: 7 - Get Notification Preferences
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/me/notification-preferences
  body: none
  auth: inherit
}

tests {
  test("returns expected status", function() {
    expect(res.getStatus() === 200).to.equal(true);
  });
}

docs {
  Returns the stored preference plus whether EMAIL_NOTIFY is currently available for this tenant.
  Opt-in via PATCH is rejected with 403 FEATURE_NOT_ENABLED when emailNotifyAvailable is false.
}
