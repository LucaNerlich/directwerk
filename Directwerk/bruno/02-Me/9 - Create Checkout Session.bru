meta {
  name: 9 - Create Checkout Session
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/me/billing/checkout-sessions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "productSlug": "supporter",
    "successUrl": "http://localhost:3001/checkout/success",
    "cancelUrl": "http://localhost:3001/checkout/cancel"
  }
}

tests {
  test("returns checkout URL or Stripe not ready", function() {
    expect([201, 400, 403, 404, 409, 501]).to.include(res.getStatus());
    if (res.getStatus() === 501) {
      expect(res.body.errors[0].code).to.equal("STRIPE_NOT_IMPLEMENTED");
    }
    if (res.getStatus() === 409) {
      expect(res.body.errors[0].code).to.equal("STRIPE_NOT_CONNECTED");
    }
    if (res.getStatus() === 201) {
      expect(res.body.data.url).to.be.a("string");
    }
  });
}

docs {
  POST /api/v1/me/billing/checkout-sessions — MeBillingController.
  Body: productSlug (required), optional successUrl/cancelUrl (HTTPS or loopback;
  host must be tenant domain, studio, or localhost). Missing URLs default to the
  tenant primary domain /checkout/success and /checkout/cancel.
  201 {url} when keys + Connect + price are ready;
  409 STRIPE_NOT_CONNECTED without a chargeable Connect account;
  501 STRIPE_NOT_IMPLEMENTED without platform keys.
}
