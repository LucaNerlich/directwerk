meta {
  name: 10 - Create Customer Portal
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/me/billing/portal
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "returnUrl": "http://localhost:3001/account"
  }
}

tests {
  test("portal is live or not configured", function() {
    expect([201, 409, 501]).to.include(res.getStatus());
    if (res.getStatus() === 501) {
      expect(res.body.errors[0].code).to.equal("STRIPE_NOT_IMPLEMENTED");
    }
    if (res.getStatus() === 201) {
      expect(res.body.data.url).to.be.a("string");
    }
  });
}

docs {
  POST /api/v1/me/billing/portal — MeBillingController.
  Optional returnUrl (same host rules as checkout). Body may be {}.
  201 {url} for a Stripe-sourced customer; 409 without a Stripe customer;
  501 STRIPE_NOT_IMPLEMENTED without platform keys.
}
